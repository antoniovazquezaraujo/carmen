{
  "name": "moderanger",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build && npm run build:cli",
    "watch": "ng build --watch --configuration development",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "midi": "npm run build:cli --silent && node packages/compiler/dist/cli/main.js compile",
    "build:core": "tsc -p packages/core/tsconfig.build.json",
    "build:compiler": "tsc -p packages/compiler/tsconfig.build.json",
    "build:cli": "npm run build:core && npm run build:compiler"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^21.2.25",
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.25",
    "@angular/compiler": "^21.2.25",
    "@angular/core": "^21.2.25",
    "@angular/forms": "^21.2.25",
    "@angular/platform-browser": "^21.2.25",
    "@angular/platform-browser-dynamic": "^21.2.25",
    "@angular/router": "^21.2.25",
    "@primeng/themes": "^21.0.4",
    "flatted": "^3.4.4",
    "primeflex": "^4.0.0",
    "primeicons": "^8.0.2",
    "primeng": "^21.1.10",
    "rxjs": "~7.8.2",
    "tone": "^14.8.26",
    "tslib": "^2.8.1",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.2.29",
    "@angular/cli": "^21.2.29",
    "@angular/compiler-cli": "^21.2.25",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "jest": "^30.5.2",
    "rimraf": "^5.0.10",
    "ts-jest": "^29.4.14",
    "ts-prune": "^0.10.3",
    "typescript": "^5.9.3"
  },
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  }
}
