{
  "name": "moderanger",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build && npm run build:cli",
    "watch": "ng build --watch --configuration development",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "midi": "npm run build:cli --silent && node packages/compiler/dist/cli/main.js compile",
    "build:core": "tsc -p packages/core/tsconfig.build.json",
    "build:compiler": "tsc -p packages/compiler/tsconfig.build.json",
    "build:cli": "npm run build:core && npm run build:compiler"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^17.3.12",
    "@angular/cdk": "^13.3.3",
    "@angular/common": "^17.3.12",
    "@angular/compiler": "^17.3.12",
    "@angular/core": "^17.3.12",
    "@angular/forms": "^17.3.12",
    "@angular/platform-browser": "^17.3.12",
    "@angular/platform-browser-dynamic": "^17.3.12",
    "@angular/router": "^17.3.12",
    "flatted": "^3.4.4",
    "primeflex": "^3.3.1",
    "primeicons": "^5.0.0",
    "primeng": "^13.4.1",
    "rxjs": "~7.8.2",
    "tone": "^14.8.26",
    "tslib": "^2.8.1",
    "zone.js": "~0.14.10"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^17.3.17",
    "@angular/cli": "^17.3.17",
    "@angular/compiler-cli": "^17.3.12",
    "@types/jest": "^29.5.14",
    "@types/node": "^12.20.55",
    "jest": "^29.7.0",
    "rimraf": "^5.0.10",
    "ts-jest": "^29.4.14",
    "ts-prune": "^0.10.3",
    "typescript": "^5.4.5"
  },
  "workspaces": [
    "packages/*"
  ]
}