{
  "name": "carmen-cli",
  "version": "1.1.0",
  "main": "dist/compile-midi.js",
  "bin": {
    "carmen": "dist/cli/main.js"
  },
  "dependencies": {
    "carmen-core": "1.1.0"
  },
  "types": "dist/compile-midi.d.ts",
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.build.json"
  },
  "description": "Browser-free .mr to MIDI compiler and CLI.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/antoniovazquezaraujo/carmen.git",
    "directory": "packages/compiler"
  },
  "engines": {
    "node": ">=16"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.js.map"
  ],
  "publishConfig": {
    "access": "public"
  }
}
